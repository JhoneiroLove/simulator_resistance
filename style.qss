/* style.qss: Modern, clean, red-based stylesheet for Simulador Evolutivo */

/* ============================================ */
/* BASE STYLES */
/* ============================================ */
QWidget {
    background-color: #F5F7FA;
    color: #2C3E50;
    font-family: 'Segoe UI', 'Roboto', 'Arial', sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #F5F7FA;
}

/* ============================================ */
/* GROUP BOX - Cards con sombra */
/* ============================================ */
QGroupBox {
    border: 1px solid #E1E8ED;
    border-radius: 8px;
    background: #FFFFFF;
    margin-top: 20px;
    padding: 16px;
    font-size: 13px;
}

QGroupBox::title {
    color: #841C1C;
    font-size: 14px;
    font-weight: 600;
    padding: 0 8px;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
}

/* ============================================ */
/* BUTTONS - Con límite de ancho */
/* ============================================ */
QPushButton {
    background-color: #841C1C;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
    min-width: 100px;
    max-width: 250px;
}

QPushButton:hover {
    background-color: #A93232;
}

QPushButton:pressed {
    background-color: #641212;
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton:disabled {
    background-color: #BDC3C7;
    color: #7F8C8D;
}

/* Botones secundarios */
QPushButton[secondary="true"] {
    background: #FFFFFF;
    color: #841C1C;
    border: 2px solid #841C1C;
}

QPushButton[secondary="true"]:hover {
    background: #FDEDEC;
    border-color: #A93232;
}

QPushButton[secondary="true"]:pressed {
    background: #F8E0E0;
}

/* ============================================ */
/* TABS */
/* ============================================ */
QTabBar::tab {
    background: #FFFFFF;
    color: #5A6C7D;
    border: 1px solid #E1E8ED;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 10px 18px;
    font-weight: 500;
    margin-right: 3px;
    font-size: 13px;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #841C1C;
    border-bottom: 3px solid #841C1C;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: #F8F9FA;
    color: #2C3E50;
}

QTabBar::tab:disabled {
    color: #BDC3C7;
    background: #F5F7FA;
}

QTabWidget::pane {
    border: 1px solid #E1E8ED;
    background: #FFFFFF;
    border-radius: 8px;
    top: -1px;
}

/* ============================================ */
/* TABLES */
/* ============================================ */
QHeaderView::section {
    background: #F8F9FA;
    color: #2C3E50;
    font-weight: 600;
    border: none;
    border-bottom: 2px solid #E1E8ED;
    padding: 10px 8px;
    font-size: 13px;
}

QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E1E8ED;
    border-radius: 6px;
    gridline-color: #E1E8ED;
    font-size: 13px;
}

QTableWidget::item {
    padding: 6px 8px;
}

QTableWidget::item:selected {
    background: #FDEDEC;
    color: #841C1C;
}

QTableWidget::item:hover {
    background: #F8F9FA;
}

/* ============================================ */
/* INPUTS */
/* ============================================ */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    border: 1px solid #D1D8DD;
    border-radius: 6px;
    padding: 8px 12px;
    background: #FFFFFF;
    font-size: 13px;
    selection-background-color: #FDEDEC;
    selection-color: #841C1C;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid #841C1C;
    background: #FFFFFF;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #F5F7FA;
    color: #95A5A6;
    border-color: #E1E8ED;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #841C1C;
    margin-right: 8px;
}

/* ============================================ */
/* SCROLLBARS */
/* ============================================ */
QScrollBar:vertical {
    background: #F5F7FA;
    width: 12px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #BDC3C7;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #95A5A6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #F5F7FA;
    height: 12px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #BDC3C7;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #95A5A6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}


/* ============================================ */
/* PROGRESS BARS */
/* ============================================ */
QProgressBar {
    border: 1px solid #E1E8ED;
    border-radius: 6px;
    background: #F5F7FA;
    text-align: center;
    height: 24px;
    font-size: 13px;
    font-weight: 600;
    color: #2C3E50;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #841C1C, stop:1 #A93232);
    border-radius: 5px;
}

/* Texto blanco cuando el progress bar está lleno */
QProgressBar[value="100"] {
    color: #FFFFFF;
    font-weight: bold;
}

/* ============================================ */
/* RADIO BUTTONS & CHECKBOXES */
/* ============================================ */
QRadioButton, QCheckBox {
    spacing: 8px;
    color: #2C3E50;
    font-size: 13px;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #BDC3C7;
    background: #FFFFFF;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background: #841C1C;
    border-color: #841C1C;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover {
    border-color: #A93232;
}

QCheckBox::indicator {
    border-radius: 4px;
}

/* ============================================ */
/* LABELS */
/* ============================================ */
QLabel {
    color: #2C3E50;
    background: transparent;
}

QLabel[heading="true"] {
    font-size: 16px;
    font-weight: 600;
    color: #1A252F;
}

QLabel[subheading="true"] {
    font-size: 14px;
    font-weight: 600;
    color: #34495E;
}

/* ============================================ */
/* LIST WIDGETS */
/* ============================================ */
QListWidget {
    background: #FFFFFF;
    border: 1px solid #E1E8ED;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 8px;
    border-radius: 4px;
    margin: 2px;
}

QListWidget::item:selected {
    background: #FDEDEC;
    color: #841C1C;
}

QListWidget::item:hover:!selected {
    background: #F8F9FA;
}

/* ============================================ */
/* SCROLL AREAS */
/* ============================================ */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ============================================ */
/* TEXT EDIT */
/* ============================================ */
QTextEdit {
    border: 1px solid #D1D8DD;
    border-radius: 6px;
    padding: 8px;
    background: #FFFFFF;
    font-size: 13px;
    selection-background-color: #FDEDEC;
    selection-color: #841C1C;
}

QTextEdit:focus {
    border: 2px solid #841C1C;
}
