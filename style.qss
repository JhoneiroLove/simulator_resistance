/* style.qss: Modern, clean, red-based stylesheet for Simulador Evolutivo */

/* ============================================ */
/* BASE STYLES */
/* ============================================ */
QWidget {
    background-color: #F5F7FA;
    color: #2C3E50;
    font-family: 'Segoe UI', 'Roboto', 'Arial', sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #F5F7FA;
}

/* ============================================ */
/* GROUP BOX - Cards con sombra */
/* ============================================ */
QGroupBox {
    border: 1px solid #E1E8ED;
    border-radius: 8px;
    background: #FFFFFF;
    margin-top: 24px;
    padding: 20px;
    font-size: 13px;
}

QGroupBox::title {
    color: #841C1C;
    font-size: 15px;
    font-weight: 700;
    padding: 0 10px;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: -2px;
}

/* ============================================ */
/* BUTTONS - Con límite de ancho */
/* ============================================ */
QPushButton {
    background-color: #841C1C;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 600;
    min-width: 120px;
    max-width: 280px;
    min-height: 40px;
}

QPushButton:hover {
    background-color: #A93232;
    padding: 12px 24px;
}

QPushButton:pressed {
    background-color: #641212;
    padding: 13px 24px 11px 24px;
}

QPushButton:disabled {
    background-color: #D5DBDB;
    color: #95A5A6;
}

/* Botones secundarios */
QPushButton[secondary="true"] {
    background: #FFFFFF;
    color: #841C1C;
    border: 2px solid #841C1C;
    min-height: 40px;
}

QPushButton[secondary="true"]:hover {
    background: #FDEDEC;
    border-color: #A93232;
    color: #A93232;
}

QPushButton[secondary="true"]:pressed {
    background: #F8E0E0;
    padding: 13px 24px 11px 24px;
}

QPushButton[secondary="true"]:disabled {
    background: #F5F7FA;
    border-color: #D5DBDB;
    color: #BDC3C7;
}

/* ============================================ */
/* TABS */
/* ============================================ */
QTabBar::tab {
    background: #FFFFFF;
    color: #5A6C7D;
    border: 1px solid #E1E8ED;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 12px 24px;
    font-weight: 500;
    margin-right: 3px;
    font-size: 13px;
    min-width: 140px;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #841C1C;
    border-bottom: 3px solid #841C1C;
    font-weight: 700;
    padding-bottom: 11px;
}

QTabBar::tab:hover:!selected {
    background: #F8F9FA;
    color: #2C3E50;
    border-bottom: 3px solid #D5DBDB;
}

QTabBar::tab:disabled {
    color: #BDC3C7;
    background: #F5F7FA;
    border-bottom: 3px solid transparent;
}

QTabWidget::pane {
    border: 1px solid #E1E8ED;
    background: #FFFFFF;
    border-radius: 8px;
    top: -1px;
}

/* ============================================ */
/* TABLES */
/* ============================================ */
QHeaderView::section {
    background: #F8F9FA;
    color: #2C3E50;
    font-weight: 700;
    border: none;
    border-bottom: 2px solid #E1E8ED;
    padding: 12px 10px;
    font-size: 13px;
}

QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E1E8ED;
    border-radius: 6px;
    gridline-color: #E8EDEF;
    font-size: 13px;
}

QTableWidget::item {
    padding: 10px 12px;
    border-bottom: 1px solid #F5F7FA;
}

QTableWidget::item:selected {
    background: #FDEDEC;
    color: #841C1C;
    font-weight: 600;
}

QTableWidget::item:hover {
    background: #F8F9FA;
}

/* ============================================ */
/* INPUTS */
/* ============================================ */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    border: 2px solid #D1D8DD;
    border-radius: 6px;
    padding: 10px 12px;
    background: #FFFFFF;
    font-size: 13px;
    selection-background-color: #FDEDEC;
    selection-color: #841C1C;
    min-height: 36px;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border: 2px solid #95A5A6;
    background: #FAFBFC;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid #841C1C;
    background: #FFFFFF;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #F5F7FA;
    color: #95A5A6;
    border-color: #E1E8ED;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 7px solid #841C1C;
    margin-right: 8px;
}

QComboBox::down-arrow:hover {
    border-top-color: #A93232;
}

/* ============================================ */
/* SCROLLBARS */
/* ============================================ */
QScrollBar:vertical {
    background: #F5F7FA;
    width: 14px;
    border-radius: 7px;
    margin: 3px;
}

QScrollBar::handle:vertical {
    background: #BDC3C7;
    border-radius: 6px;
    min-height: 40px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #95A5A6;
}

QScrollBar::handle:vertical:pressed {
    background: #7F8C8D;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: #F5F7FA;
    height: 14px;
    border-radius: 7px;
    margin: 3px;
}

QScrollBar::handle:horizontal {
    background: #BDC3C7;
    border-radius: 6px;
    min-width: 40px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #95A5A6;
}

QScrollBar::handle:horizontal:pressed {
    background: #7F8C8D;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: transparent;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* ============================================ */
/* PROGRESS BARS */
/* ============================================ */
QProgressBar {
    border: 2px solid #E1E8ED;
    border-radius: 8px;
    background: #F5F7FA;
    text-align: center;
    height: 28px;
    font-size: 13px;
    font-weight: 700;
    color: #2C3E50;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #841C1C, stop:0.5 #A93232, stop:1 #841C1C);
    border-radius: 6px;
    margin: 2px;
}

/* Texto blanco cuando el progress bar está lleno */
QProgressBar[value="100"] {
    color: #FFFFFF;
    font-weight: bold;
    border-color: #841C1C;
}

/* ============================================ */
/* RADIO BUTTONS & CHECKBOXES */
/* ============================================ */
QRadioButton, QCheckBox {
    spacing: 10px;
    color: #2C3E50;
    font-size: 13px;
    padding: 4px;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border: 2px solid #BDC3C7;
    background: #FFFFFF;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background: qradialgradient(
        cx:0.5, cy:0.5, radius:0.5,
        fx:0.5, fy:0.5,
        stop:0 #841C1C, 
        stop:0.6 #841C1C,
        stop:0.65 #FFFFFF,
        stop:1 #FFFFFF
    );
    border-color: #841C1C;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover {
    border-color: #A93232;
    background: #FAFBFC;
}

QRadioButton::indicator:disabled, QCheckBox::indicator:disabled {
    background: #F5F7FA;
    border-color: #D5DBDB;
}

QCheckBox::indicator {
    border-radius: 5px;
}

QCheckBox::indicator:checked {
    background: #841C1C;
    border-color: #841C1C;
}

/* ============================================ */
/* LABELS */
/* ============================================ */
QLabel {
    color: #2C3E50;
    background: transparent;
    line-height: 1.5;
}

QLabel[heading="true"] {
    font-size: 18px;
    font-weight: 700;
    color: #1A252F;
    margin-bottom: 8px;
}

QLabel[subheading="true"] {
    font-size: 15px;
    font-weight: 600;
    color: #34495E;
    margin-bottom: 6px;
}

/* ============================================ */
/* LIST WIDGETS */
/* ============================================ */
QListWidget {
    background: #FFFFFF;
    border: 2px solid #E1E8ED;
    border-radius: 6px;
    padding: 6px;
    outline: none;
}

QListWidget::item {
    padding: 10px 12px;
    border-radius: 5px;
    margin: 2px;
    border: 1px solid transparent;
}

QListWidget::item:selected {
    background: #FDEDEC;
    color: #841C1C;
    border: 1px solid #841C1C;
    font-weight: 600;
}

QListWidget::item:hover:!selected {
    background: #F8F9FA;
    border: 1px solid #E1E8ED;
}

QListWidget::item:focus {
    outline: none;
    border: 1px solid #841C1C;
}

/* ============================================ */
/* SCROLL AREAS */
/* ============================================ */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ============================================ */
/* TEXT EDIT */
/* ============================================ */
QTextEdit {
    border: 1px solid #D1D8DD;
    border-radius: 6px;
    padding: 8px;
    background: #FFFFFF;
    font-size: 13px;
    selection-background-color: #FDEDEC;
    selection-color: #841C1C;
}

QTextEdit:focus {
    border: 2px solid #841C1C;
}

/* ============================================ */
/* MESSAGE BOX (POPUPS) */
/* ============================================ */
QMessageBox {
    background-color: #FFFFFF;
    font-size: 13px;
}

QMessageBox QPushButton {
    min-width: 80px;
    max-width: 120px;
    min-height: 32px;
    padding: 8px 16px;
    font-size: 12px;
    margin: 2px;
}

QMessageBox QPushButton:hover {
    padding: 8px 16px;
}

QMessageBox QPushButton:pressed {
    padding: 9px 16px 7px 16px;
}

QMessageBox QLabel {
    font-size: 13px;
    color: #2C3E50;
    margin: 8px;
}
